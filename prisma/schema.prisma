// Prisma schema = the shape of your database (tables + columns + relations).
// In Prisma 7 the database URL lives in prisma.config.ts (not here).

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(cuid())
  name      String?
  email     String     @unique
  /// Avatar URL (app proxy or Storage public URL), e.g. /api/avatars/xyz
  image     String?
  /// Hashed password (never store plain text).
  password  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  favorites Favorite[]
}

/// A TMDB title the user saved to Favorites or Watchlist.
/// We cache title/poster so list pages don’t need TMDB for every row.
model Favorite {
  id         String   @id @default(cuid())
  userId     String
  /// TMDB id (movie or TV — disambiguated by mediaType).
  movieId    Int
  /// "movie" | "tv"
  mediaType  String   @default("movie")
  title      String
  posterPath String?
  /// "favorite" (loved / rated) or "watchlist" (want to watch).
  listType   String   @default("favorite")
  /// Personal score 1–10 (favorites only). Null = not rated yet.
  rating     Int?
  /// Short note (favorites only).
  note       String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId, listType, mediaType])
  @@index([userId])
  @@index([userId, listType])
}

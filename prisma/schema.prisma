// Prisma schema = the shape of your database (tables + columns + relations).
// In Prisma 7 the database URL lives in prisma.config.ts (not here).

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String     @id @default(cuid())
  name      String?
  email     String     @unique
  /// Hashed password (never store plain text).
  password  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  favorites Favorite[]
}

/// A TMDB movie the user saved. We store title/poster so the list page
/// does not need to call TMDB for every row.
model Favorite {
  id         String   @id @default(cuid())
  userId     String
  movieId    Int
  title      String
  posterPath String?
  /// Personal score 1–10 (optional). Null = not rated yet.
  rating     Int?
  /// Short “why I saved this” note (optional).
  note       String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([userId])
}

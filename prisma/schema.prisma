// Prisma schema = the shape of your database (tables + columns + relations).
// In Prisma 7 the database URL lives in prisma.config.ts (not here).

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(cuid())
  name      String?
  email     String     @unique
  /// Set when the user confirms ownership of the email (OTP).
  emailVerified DateTime?
  /// Avatar URL (app proxy or Storage public URL), e.g. /api/avatars/xyz
  image     String?
  /// Hashed password (never store plain text).
  password  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  favorites Favorite[]
  tvEpisodeWatches TvEpisodeWatch[]
}

/// One-time codes for signup email verification.
model EmailOtp {
  id        String   @id @default(cuid())
  email     String
  /// bcrypt hash of the 6-digit code
  codeHash  String
  purpose   String   @default("signup")
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, purpose])
}

/// A TMDB title the user saved to Favorites, Watchlist, or Watched.
/// We cache title/poster so list pages don’t need TMDB for every row.
model Favorite {
  id         String   @id @default(cuid())
  userId     String
  /// TMDB id (movie or TV — disambiguated by mediaType).
  movieId    Int
  /// "movie" | "tv"
  mediaType  String   @default("movie")
  title      String
  posterPath String?
  /// "favorite" | "watchlist" | "watched"
  listType   String   @default("favorite")
  /// Personal score 1–10 (favorites only). Null = not rated yet.
  rating     Int?
  /// Short note — favorites (why you like it) or watched diary log.
  note       String?
  /// When the user watched this title (watched list only).
  watchedAt  DateTime?
  /// Extra plays after the first log (watched list only). 0 = first watch.
  rewatchCount Int @default(0)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId, listType, mediaType])
  @@index([userId])
  @@index([userId, listType])
}

/// Per-episode watch log for TV progress (season/episode checklist).
model TvEpisodeWatch {
  id            String   @id @default(cuid())
  userId        String
  /// TMDB TV show id.
  showId        Int
  seasonNumber  Int
  episodeNumber Int
  watchedAt     DateTime @default(now())
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, showId, seasonNumber, episodeNumber])
  @@index([userId, showId])
}

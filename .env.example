# Copy to .env.local and fill in real values.
# Never commit .env.local — it contains secrets.
#
# Where to get each variable:
#
# TMDB_*
#   https://www.themoviedb.org/settings/api
#
# NEXT_PUBLIC_SUPABASE_*
#   Supabase → Project Settings → API
#   Optional for this app (DB goes through Prisma + DATABASE_URL).
#
# DATABASE_URL
#   Supabase → Connect → ORM → Prisma → Transaction pooler (port 6543)
#   Must include ?pgbouncer=true for Prisma + pooler.
#
# DIRECT_URL
#   Same dialog → Session pooler or Direct (port 5432)
#   Used by `npm run db:migrate` (prisma.config.ts).
#
# AUTH_SECRET
#   openssl rand -base64 32
#   Rotate after wiping the DB so old session cookies die.
#
# AUTH_URL
#   Local: http://localhost:3000
#   Production: https://your-app.vercel.app (no trailing slash)
#
# S3_*
#   Ramaki / S3-compatible blob storage for avatars.
#   Browser loads photos via /api/avatars/[userId] (bucket is private).

TMDB_API_KEY=
TMDB_ACCESS_TOKEN=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# Optional shared TMDB cache (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

AUTH_SECRET=
AUTH_URL=http://localhost:3000

S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_BUCKET=
S3_ENDPOINT=
